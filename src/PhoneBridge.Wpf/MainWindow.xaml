<Window x:Class="PhoneBridge.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PhoneBridge.Wpf.ViewModels"
        xmlns:views="clr-namespace:PhoneBridge.Wpf.Views"
        Title="PhoneBridge Launcher" Width="1280" Height="800" MinWidth="980" MinHeight="620"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DevicesViewModel}"><views:DevicesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GamesViewModel}"><views:PlaceholderView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:KeymappingViewModel}"><views:PlaceholderView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}"><views:DiagnosticsView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="PhoneBridge" FontSize="20" FontWeight="Bold" Margin="20,22,20,18" />
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding AdbStatusText}" Style="{StaticResource Muted}" Margin="20,0,20,16" />
                <ListBox Style="{StaticResource NavListBox}" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" FontSize="14" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,0,1" Padding="20,12">
                <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Left" Style="{StaticResource AccentButton}" MinWidth="110"
                            Content="{Binding ConnectButtonText}" Command="{Binding ToggleConnectionCommand}" />
                    <Button DockPanel.Dock="Left" Margin="10,0,0,0" Content="Open Game Window"
                            IsEnabled="{Binding Session.IsConnected}" Click="OpenGameClick" />
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="14,0,0,0"
                               Text="{Binding Session.SelectedDevice.DisplayName, FallbackValue='No device selected'}" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FpsText}" Foreground="{StaticResource MutedBrush}" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding StreamLatencyText}" Foreground="{StaticResource MutedBrush}" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding InputLatencyText}" Foreground="{StaticResource MutedBrush}" Margin="0,0,20,0" />
                        <TextBlock Text="Profile" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" MinWidth="130" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Background="{StaticResource DangerBrush}" Padding="20,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BannerText}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" Foreground="White" />
            </Border>

            <ContentControl Grid.Row="2" Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</Window>
