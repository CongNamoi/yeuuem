<Window x:Class="PhoneBridge.Wpf.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhoneBridge Game" Width="1120" Height="720" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterScreen" Background="#101218" Foreground="White"
        Loaded="OnLoaded" Closing="OnClosing" Closed="OnClosed" PreviewKeyDown="OnKeyDown" PreviewKeyUp="OnKeyUp" Deactivated="OnDeactivated">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0">
            <Border DockPanel.Dock="Bottom" Background="#171C27" Padding="12,8">
                <StackPanel>
                    <TextBlock x:Name="Status" Text="Starting mirror…" TextWrapping="Wrap" />
                    <TextBlock x:Name="Metrics" Foreground="#ACB6CA" />
                </StackPanel>
            </Border>
            <Border Background="Black" ClipToBounds="True">
                <Grid x:Name="Surface" Background="Transparent" ClipToBounds="True" Focusable="True"
                      MouseLeftButtonDown="OnTouchDown" MouseLeftButtonUp="OnTouchUp" MouseMove="OnTouchMove"
                      LostKeyboardFocus="OnSurfaceFocusLost" LostMouseCapture="OnTouchCaptureLost" SizeChanged="OnSurfaceSizeChanged">
                    <Grid.LayoutTransform>
                        <RotateTransform x:Name="VideoRotation" />
                    </Grid.LayoutTransform>
                    <Image x:Name="Video" Stretch="Uniform" IsHitTestVisible="False"
                           RenderOptions.BitmapScalingMode="LowQuality" />
                    <Canvas x:Name="Markers" IsHitTestVisible="False" />
                </Grid>
            </Border>
        </DockPanel>
        <ScrollViewer x:Name="Toolbar" Grid.Column="1" Background="#171C27" VerticalScrollBarVisibility="Auto">
            <StackPanel Width="172" Margin="10">
                <StackPanel.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Margin" Value="0,0,0,6" />
                    </Style>
                </StackPanel.Resources>
                <Button x:Name="MappingButton" Content="Keymapping Editor" Click="MappingClick" IsEnabled="False" />
                <StackPanel x:Name="MappingPanel" Visibility="Collapsed">
                    <TextBlock Text="Click a spot, then press A–Z or 0–9. To move a binding, pick a new spot and press its key again."
                               TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock x:Name="MappingStatus" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ComboBox x:Name="MappingKeys" Margin="0,0,0,6" />
                    <Button Content="Remove Selected Key" Click="RemoveMappingClick" />
                </StackPanel>
                <Button Content="Fullscreen (F11)" Click="FullscreenClick" />
                <Button Content="Hide Toolbar (F12)" Click="ToolbarClick" />
                <Button x:Name="Screenshot" Content="Screenshot" Click="ScreenshotClick" IsEnabled="False" />
                <Button Content="Rotate View" Click="RotateClick" />
                <Button Content="Volume" IsEnabled="False" />
                <Button Content="Stream Settings" Click="SettingsClick" />
                <Button Content="Return to Launcher" Click="LauncherClick" />
                <Button x:Name="StreamButton" Content="Start Stream" Click="StreamClick" />
                <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Margin="0,8,0,0">
                    <Label Content="FPS cap" Target="{Binding ElementName=Fps}" Foreground="White" />
                    <ComboBox x:Name="Fps" SelectedIndex="1">
                        <ComboBoxItem Content="30" /><ComboBoxItem Content="60" />
                        <ComboBoxItem Content="90" /><ComboBoxItem Content="120" />
                    </ComboBox>
                    <Label Content="Max long edge (px)" Target="{Binding ElementName=SizeLimit}" Foreground="White" />
                    <ComboBox x:Name="SizeLimit" SelectedIndex="1">
                        <ComboBoxItem Content="960" /><ComboBoxItem Content="1280" />
                        <ComboBoxItem Content="1600" /><ComboBoxItem Content="1920" />
                    </ComboBox>
                    <Label Content="Bitrate (Mbps)" Target="{Binding ElementName=Bitrate}" Foreground="White" />
                    <ComboBox x:Name="Bitrate" SelectedIndex="1">
                        <ComboBoxItem Content="4" /><ComboBoxItem Content="8" />
                        <ComboBoxItem Content="12" /><ComboBoxItem Content="20" />
                    </ComboBox>
                    <Label Content="Codec" Target="{Binding ElementName=Codec}" Foreground="White" />
                    <ComboBox x:Name="Codec" SelectedIndex="0">
                        <ComboBoxItem Content="H.264" /><ComboBoxItem Content="H.265" />
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
