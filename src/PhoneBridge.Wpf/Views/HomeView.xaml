<UserControl x:Class="PhoneBridge.Wpf.Views.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Border Style="{StaticResource Card}" Background="#0B0D10">
            <Viewbox Stretch="Uniform" MaxWidth="900">
                <TextBlock Text="{Binding ViewportMessage}" TextAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" FontSize="20" Margin="40" />
            </Viewbox>
        </Border>
    </Grid>
</UserControl>
