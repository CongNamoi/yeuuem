<UserControl x:Class="PhoneBridge.Wpf.Views.PlaceholderView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="28" MaxWidth="640" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" />
        <TextBlock Text="{Binding Phase}" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10" />
        <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" />
    </StackPanel>
</UserControl>
