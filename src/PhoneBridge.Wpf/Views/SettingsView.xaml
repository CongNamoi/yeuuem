<UserControl x:Class="PhoneBridge.Wpf.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="28" MaxWidth="720" HorizontalAlignment="Left">
        <TextBlock Text="Settings" Style="{StaticResource Heading}" />
        <TextBlock Text="adb.exe path (leave empty to auto-detect)" Style="{StaticResource Muted}" Margin="0,0,0,6" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
            <TextBox Text="{Binding AdbPath, UpdateSourceTrigger=PropertyChanged}" Width="520" />
        </DockPanel>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Save" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
            <Button Content="Detect" Command="{Binding DetectCommand}" />
        </StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <TextBlock Text="{Binding AdbInfo}" Style="{StaticResource Value}" />
        </Border>
        <TextBlock Margin="0,12,0,0" Style="{StaticResource Muted}">
            <Run Text="Settings file: " /><Run Text="{Binding SettingsFile, Mode=OneWay}" />
        </TextBlock>
    </StackPanel>
</UserControl>
